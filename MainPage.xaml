<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Subscription_tracker.MainPage"
             Title="Mis suscripciones">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnAddSubscriptionClicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="20" Spacing="16">

        <!-- Resumen -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Resumen mensual"
                   FontSize="22"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="12">
                <VerticalStackLayout>
                    <Label Text="Suscripciones"
                           FontSize="12"
                           TextColor="{DynamicResource Gray600}" />
                    <Label x:Name="TotalSubscriptionsLabel"
                           Text="0"
                           FontSize="18"
                           FontAttributes="Bold" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Gasto mensual"
                           FontSize="12"
                           TextColor="{DynamicResource Gray600}" />
                    <Label x:Name="TotalAmountLabel"
                           Text="$0.00"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#FF3B30" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <BoxView HeightRequest="1"
                 Color="{DynamicResource Gray300}" />

        <!-- Filtros simples -->
        <HorizontalStackLayout Spacing="8">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Buscar suscripción..."
                       HorizontalOptions="FillAndExpand"
                       TextChanged="OnSearchTextChanged" />

            <Picker x:Name="BillingCyclePicker"
                    Title="Ciclo"
                    WidthRequest="120"
                    SelectedIndexChanged="OnBillingCycleFilterChanged">
                <Picker.Items>
                    <x:String>Todos</x:String>
                    <x:String>Mensual</x:String>
                    <x:String>Anual</x:String>
                </Picker.Items>
            </Picker>
        </HorizontalStackLayout>

        <!-- Lista -->
        <CollectionView x:Name="SubscriptionsCollection"
                        Margin="0,8,0,0"
                        SelectionMode="Single"
                        SelectionChanged="OnSubscriptionSelected">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="Aún no tienes suscripciones."
                           HorizontalTextAlignment="Center" />
                    <Label Text="Toca el + para agregar la primera."
                           FontSize="12"
                           TextColor="{DynamicResource Gray500}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="{DynamicResource Gray300}"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,0,0,10"
                            BackgroundColor="{DynamicResource White}"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*, Auto"
                              RowDefinitions="Auto, Auto, Auto">

                            <!-- Nombre + precio -->
                            <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="StartAndExpand" />
                                <Label Text="{Binding MonthlyCost, StringFormat='${0:F2}'}"
                                       FontAttributes="Bold"
                                       TextColor="#FF3B30"
                                       HorizontalOptions="End" />
                            </HorizontalStackLayout>

                            <!-- Ciclo + próximo cobro -->
                            <HorizontalStackLayout Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Spacing="8"
                                                   Margin="0,4,0,0">
                                <Label Text="{Binding BillingCycle}"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray600}" />
                                <Label Text="·"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray600}" />
                                <Label Text="Próximo:"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray600}" />
                                <Label Text="{Binding NextChargeDate, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray800}" />
                            </HorizontalStackLayout>

                            <!-- Notas -->
                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,0"
                                   Text="{Binding Notes}"
                                   FontSize="12"
                                   TextColor="{DynamicResource Gray600}"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botón flotante abajo -->
        <Button Text="Agregar suscripción"
                Margin="0,8,0,0"
                CornerRadius="24"
                HeightRequest="48"
                Clicked="OnAddSubscriptionClicked"
                HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>
