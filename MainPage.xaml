<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Subscription_tracker.MainPage"
             Title="Mis suscripciones">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnAddSubscriptionClicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="20" Spacing="16">

        <!-- Estado de conexión -->
        <HorizontalStackLayout HorizontalOptions="End" Spacing="5">
            <Label Text="Status:"
                   FontSize="12"/>
            <Label x:Name="ConnectivityStatusLabel"
                   Text="Online"
                   TextColor="Green"
                   FontSize="12"
                   FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <!-- Resumen -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Summary"
                   FontSize="22"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="12">
                <VerticalStackLayout>
                    <Label Text="Subscriptions"
                           FontSize="12"
                           TextColor="{DynamicResource Gray600}" />
                    <Label x:Name="SubscriptionCountLabel"
                           Text="0 active"
                           FontSize="18"
                           FontAttributes="Bold" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Monthly"
                           FontSize="12"
                           TextColor="{DynamicResource Gray600}" />
                    <Label x:Name="MonthlyCostLabel"
                           Text="$0.00"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#FF3B30" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Biweekly"
                           FontSize="12"
                           TextColor="{DynamicResource Gray600}" />
                    <Label x:Name="BiweeklyCostLabel"
                           Text="$0.00"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#FF3B30" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <BoxView HeightRequest="1"
                 Color="{DynamicResource Gray300}" />

        <!-- Filtros simples -->
        <HorizontalStackLayout Spacing="8">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Search subscription..."
                       HorizontalOptions="FillAndExpand"
                       TextChanged="OnSearchTextChanged" />

            <Picker x:Name="BillingCyclePicker"
                    Title="Cycle"
                    WidthRequest="120"
                    SelectedIndexChanged="OnBillingCycleFilterChanged">
                <Picker.Items>
                    <x:String>All</x:String>
                    <x:String>Monthly</x:String>
                    <x:String>Biweekly</x:String>
                </Picker.Items>
            </Picker>
        </HorizontalStackLayout>

        <!-- Lista -->
        <CollectionView x:Name="SubscriptionsCollection"
                        Margin="0,8,0,0"
                        SelectionMode="Single"
                        SelectionChanged="OnSubscriptionSelected">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="No subscriptions yet."
                           HorizontalTextAlignment="Center" />
                    <Label Text="Tap + to add one."
                           FontSize="12"
                           TextColor="{DynamicResource Gray500}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="{DynamicResource Gray300}"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,0,0,10"
                            BackgroundColor="{DynamicResource White}"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*, Auto"
                              RowDefinitions="Auto, Auto, Auto">

                            <!-- Name + precio -->
                            <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2">
                                <Label Text="{Binding ServiceName}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="StartAndExpand" />
                                <Label Text="{Binding Amount, StringFormat='${0:F2}'}"
                                       FontAttributes="Bold"
                                       TextColor="#FF3B30"
                                       HorizontalOptions="End" />
                            </HorizontalStackLayout>

                            <!-- Category + próximo cobro -->
                            <HorizontalStackLayout Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Spacing="8"
                                                   Margin="0,4,0,0">
                                <Label Text="{Binding Category}"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray600}" />
                                <Label Text="·"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray600}" />
                                <Label Text="Next:"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray600}" />
                                <Label Text="{Binding NextBillingDate, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray800}" />
                            </HorizontalStackLayout>

                            <!-- Notas -->
                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,0"
                                   Text="{Binding Notes}"
                                   FontSize="12"
                                   TextColor="{DynamicResource Gray600}"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
